# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php81" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# SPA fallback: todo lo que no sea un archivo real → index.html
# (necesario para que refrescar rutas internas como /noticias/:id no dé 404)

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # No reescribir archivos/carpetas que existen físicamente (imgs, docs, assets)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Todo lo demás → index.html (lo maneja el React Router)
    RewriteRule ^ /index.html [L]
</IfModule>

# ── Compresión gzip (texto sin comprimir → ~60-80% menos) ──
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml
    # No comprimir lo que ya viene comprimido (imágenes, fuentes, zip, pdf)
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|ico|woff2?|ttf|otf|gz|zip|pdf)$ no-gzip dont-vary
</IfModule>

# ── Compresión brotli (si el servidor la soporta) ──
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
    AddOutputFilterByType BROTLI_COMPRESS application/xml application/manifest+json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|ico|woff2?|ttf|otf|gz|zip|pdf)$ no-brotli
</IfModule>

# ── Cache ──
<IfModule mod_headers.c>
    # Assets con hash de Vite (/assets/*) → 1 año inmutable
    SetEnvIf Request_URI "^/assets/" IS_VITE_ASSET
    Header set Cache-Control "public, max-age=31536000, immutable" env=IS_VITE_ASSET

    # Imágenes/fuentes con nombre estable → 30 días
    <FilesMatch "\.(?:woff2?|ttf|otf|webp|avif|svg|png|jpe?g|gif|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # HTML/JSON/XML → sin cache (evita servir index.html o índice viejos)
    <FilesMatch "\.(?:html|json|xml|txt)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>