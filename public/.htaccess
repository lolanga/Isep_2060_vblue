# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php81" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# SPA fallback: todo lo que no sea un archivo real → index.html
# (necesario para que refrescar rutas internas como /noticias/:id no dé 404)

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # No reescribir archivos/carpetas que existen físicamente (imgs, docs, assets)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Todo lo demás → index.html (lo maneja el React Router)
    RewriteRule ^ /index.html [L]
</IfModule>