# Normalize all text files to LF in the repository
* text=auto eol=lf

# Explicitly declare text files
*.jsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.svg text eol=lf

# Declare binary files
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
